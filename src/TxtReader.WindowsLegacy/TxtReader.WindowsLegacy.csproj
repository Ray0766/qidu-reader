<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>TxtReader</AssemblyName>
    <RootNamespace>TxtReader.App</RootNamespace>
    <Version>0.2.0</Version>
    <InformationalVersion>0.2.0-preview.2</InformationalVersion>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <Product>栖读</Product>
    <Description>栖读 Windows 兼容预览版 · 旧系统实测待完成</Description>
    <ApplicationIcon>..\TxtReader.App\Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>..\TxtReader.App\app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TxtReader.Core\TxtReader.Core.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TxtReader.App\*.cs" Link="%(Filename)%(Extension)" />
    <ApplicationDefinition Include="..\TxtReader.App\App.xaml" Link="App.xaml" />
    <Page Include="..\TxtReader.App\MainWindow.xaml" Link="MainWindow.xaml" />
    <Resource Include="..\TxtReader.App\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" />
    <Resource Include="..\TxtReader.App\Assets\AppIcon.png" Link="Assets\AppIcon.png" />
    <Content Include="..\..\samples\山海来信.txt" Link="samples\sample-novel.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\preview-quickstart.txt" Link="Quickstart.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
