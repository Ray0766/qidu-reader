<Window x:Class="TxtReader.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TxtReader.App"
 Title="栖读" Icon="Assets/AppIcon.ico" Width="1400" Height="900" MinWidth="1040" MinHeight="640" Background="#DDE3DF" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" PreviewDragOver="OnDragOver" PreviewKeyDown="OnKeyDown">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
<Border Background="#F4F6F2" BorderBrush="#CDD5CD" BorderThickness="0,0,0,1">
 <Grid Margin="22,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,26,0">
   <Button Click="OnShowShelf" AutomationProperties.AutomationId="ShowShelf" ToolTip="我的书架" Padding="6,8,14,8"><StackPanel Orientation="Horizontal"><Path Data="M 0,1 L 5,1 5,19 0,19 Z M 8,0 L 13,0 13,19 8,19 Z M 16,3 L 20,2 24,18 20,19 Z" Stroke="#354A40" StrokeThickness="1.3" Width="24" Height="20"/><TextBlock Text="书架" Margin="10,0,0,0"/></StackPanel></Button>
   <Button x:Name="SidebarToggle" Content="收起目录" Click="OnToggleSidebar" FontSize="12" Foreground="{StaticResource Muted}" ToolTip="显示或隐藏侧栏（Ctrl+B）" AutomationProperties.AutomationId="ToggleSidebar"/>
  </StackPanel>
  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
   <TextBlock x:Name="BookTitle" Text="栖读" FontFamily="SimSun" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="BookInfo" Text="本地小说，接着上次读" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
  </StackPanel>
  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
   <StackPanel x:Name="ReadingTools" Orientation="Horizontal">
    <Border Background="#E6EBE4" CornerRadius="5" Padding="3" Margin="0,0,14,0"><StackPanel Orientation="Horizontal">
     <Button x:Name="PageModeButton" Content="单页" Click="OnPageMode" AutomationProperties.AutomationId="PageMode"/>
     <Button x:Name="SpreadModeButton" Content="双页" Click="OnSpreadMode" AutomationProperties.AutomationId="SpreadMode"/>
     <Button x:Name="ScrollModeButton" Content="滚动" Click="OnScrollMode" AutomationProperties.AutomationId="ScrollMode"/>
    </StackPanel></Border>
    <Button Content="A−" ToolTip="缩小字号" Click="OnFontMinus" AutomationProperties.AutomationId="FontMinus" Padding="10,9"/>
    <TextBlock x:Name="FontLabel" Text="22" FontSize="13" VerticalAlignment="Center" Width="28" TextAlignment="Center"/>
    <Button Content="A+" ToolTip="增大字号" Click="OnFontPlus" AutomationProperties.AutomationId="FontPlus" Padding="10,9"/>
    <Button Content="排版" Click="OnAppearance" AutomationProperties.AutomationId="Appearance" Padding="12,9" Margin="8,0,12,0"/>
   </StackPanel>
   <Button x:Name="OpenButton" Content="导入书籍" Background="#354A40" Foreground="#F3F1E9" Click="OnOpen" AutomationProperties.AutomationId="OpenBook" Padding="16,9"/>
  </StackPanel>
 </Grid>
</Border>
<Grid x:Name="ReadingWorkspace" Grid.Row="1">
 <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="272"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border x:Name="Sidebar" Background="#EEF1EB" BorderBrush="#CDD5CD" BorderThickness="0,0,1,0">
  <Grid Margin="14,18,14,14">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TabControl x:Name="SidebarTabs" Background="Transparent" BorderThickness="0" Padding="0,12,0,0">
    <TabItem Header="目录">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="ChapterCount" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,2,0,10"/>
      <ListBox x:Name="ChapterList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="OnChapterSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="Chapters">
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" LineHeight="21"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </TabItem>
    <TabItem x:Name="SearchTab" Header="搜索" AutomationProperties.AutomationId="SearchTab">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="4,0,4,8">
       <TextBlock Text="搜索整本小说" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,8"/>
       <TextBox x:Name="SearchInput" MaxLength="256" TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" AutomationProperties.AutomationId="SearchInput" ToolTip="输入人名或原文，Enter 搜索；Ctrl+F 聚焦"/>
      </StackPanel>
      <DockPanel Grid.Row="1" Margin="4,0,4,8">
       <Button x:Name="CancelSearchButton" Content="取消" Click="OnCancelSearch" DockPanel.Dock="Right" Padding="7,4" FontSize="11" Visibility="Collapsed"/>
       <TextBlock x:Name="SearchStatus" Text="支持单字、人名和原文片段" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
      <ListBox x:Name="SearchResults" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSearchResultSelected" AutomationProperties.AutomationId="SearchResults">
       <ListBox.ItemTemplate><DataTemplate><StackPanel>
        <TextBlock Text="{Binding Chapter}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
        <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="21"><Run Text="{Binding Prefix, Mode=OneWay}"/><Run Text="{Binding Match, Mode=OneWay}" Background="#FFF0AE"/><Run Text="{Binding Suffix, Mode=OneWay}"/></TextBlock>
       </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button x:Name="SearchPrevious" Content="上一批" IsEnabled="False" Click="OnSearchPrevious" FontSize="11"/>
       <Button x:Name="SearchNext" Grid.Column="1" Content="下一批" IsEnabled="False" Click="OnSearchNext" FontSize="11"/>
      </Grid>
     </Grid>
    </TabItem>
    <TabItem x:Name="BookmarksTab" Header="书签" AutomationProperties.AutomationId="BookmarksTab">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Button Content="添加当前位置书签" Click="OnAddBookmark" Background="#DCE5D7" Margin="4,0,4,10" AutomationProperties.AutomationId="AddBookmark" ToolTip="Ctrl+D"/>
      <TextBlock x:Name="BookmarkStatus" Grid.Row="1" Text="还没有书签，读到喜欢的地方再添加" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="6,0,6,8"/>
      <ListBox x:Name="BookmarkList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnBookmarkSelected" AutomationProperties.AutomationId="BookmarkList">
       <ListBox.ItemTemplate><DataTemplate><StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding Excerpt}" FontSize="12" LineHeight="21" TextWrapping="Wrap" MaxHeight="66" TextTrimming="CharacterEllipsis"/>
        <Button Content="删除书签" Tag="{Binding}" Click="OnDeleteBookmark" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11" Padding="6,6,0,0"/>
       </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </TabItem>
   </TabControl>
   <StackPanel Grid.Row="1" Margin="12,12,12,0">
    <TextBlock Text="文件编码" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
    <ComboBox x:Name="EncodingPicker" FontSize="12" SelectionChanged="OnEncodingChanged" AutomationProperties.AutomationId="Encoding" Padding="6"/>
   </StackPanel>
  </Grid>
 </Border>
 <Grid Grid.Column="1" Margin="22,18,22,12">
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <Grid>
   <TextBlock x:Name="ChapterLabel" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
   <Button x:Name="ReturnButton" Content="返回原位置" Click="OnReturnPosition" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="4,0,8,7" FontSize="11" AutomationProperties.AutomationId="ReturnPosition"/>
  </Grid>
  <Border x:Name="ReadingPaper" Grid.Row="1" Background="#FCFCFA" MaxWidth="790" BorderBrush="#C9C6B9" BorderThickness="0,0,0,3" CornerRadius="2">
   <Border.Effect><DropShadowEffect Color="#374337" BlurRadius="24" ShadowDepth="7" Opacity="0.16"/></Border.Effect>
   <local:ReaderSurface x:Name="Reader" AutomationProperties.AutomationId="ReadingArea"/>
  </Border>
  <TextBlock x:Name="Notice" Grid.Row="2" Text="打开或拖入 TXT / EPUB，开始阅读" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
 </Grid>
</Grid>
<Border x:Name="ReadingFooter" Grid.Row="2" Background="#DDE3DF">
 <Grid Margin="24,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <TextBlock x:Name="ReadingHint" Text="左右拖动或单击翻页 · ← →" Margin="0,0,24,0" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="正文任意位置按住左右拖动；单击左半边上一页、右半边下一页；也可用方向键。F11 全屏。"/>
  <Button x:Name="PreviousButton" Grid.Column="1" Content="上一页" Click="OnPrevious" VerticalAlignment="Center" AutomationProperties.AutomationId="Previous"/>
  <Slider x:Name="ProgressSlider" Grid.Column="2" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="22,0,18,0" PreviewMouseLeftButtonUp="OnSeek" KeyUp="OnSeekKey" AutomationProperties.AutomationId="Progress"/>
  <TextBlock x:Name="ProgressLabel" Grid.Column="3" Text="0.0%" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
  <Button x:Name="NextButton" Grid.Column="4" Content="下一页" Click="OnNext" VerticalAlignment="Center" AutomationProperties.AutomationId="Next"/>
 </Grid>
</Border>
<Grid x:Name="LibraryWorkspace" Grid.Row="1" Grid.RowSpan="2" Background="#E8ECE4" Visibility="Collapsed">
 <Grid Margin="52,32,52,22" MaxWidth="1360">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="我的藏书" FontFamily="SimSun" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="ShelfCount" Text="按最近阅读排序" FontSize="12" Foreground="{StaticResource Muted}" Margin="1,10,0,0"/></StackPanel>
   <Button x:Name="ContinueReadingButton" Grid.Column="1" Content="继续当前阅读" Click="OnContinueReading" VerticalAlignment="Center" Background="#354A40" Foreground="#FAF8F2" AutomationProperties.AutomationId="ContinueReading"/>
  </Grid>
  <DockPanel Grid.Row="1" Margin="0,0,0,18"><TextBlock Text="筛选书名" VerticalAlignment="Center" FontSize="12" Margin="0,0,14,0"/><TextBox x:Name="ShelfFilter" TextChanged="OnShelfFilterChanged" Width="320" HorizontalAlignment="Left" MaxLength="120" AutomationProperties.AutomationId="ShelfFilter"/></DockPanel>
  <ListBox x:Name="ShelfList" Grid.Row="2" Padding="0" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" MouseDoubleClick="OnShelfDoubleClick" AutomationProperties.AutomationId="ShelfList">
   <ListBox.ItemsPanel><ItemsPanelTemplate><local:BookshelfPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Width" Value="210"/><Setter Property="Height" Value="326"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><Grid Margin="20,12,20,0">
    <Grid.RowDefinitions><RowDefinition Height="222"/><RowDefinition Height="24"/><RowDefinition Height="26"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Button Click="OnShelfRead" Tag="{Binding}" Padding="0" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}"><local:BookCover Book="{Binding}" Width="170" Height="222"/></Button>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="改名" Click="OnShelfRename" Tag="{Binding}" FontSize="10" Padding="5,5"/><Button Content="移出" Click="OnShelfRemove" Tag="{Binding}" FontSize="10" Padding="5,5" Foreground="{StaticResource Muted}"/></StackPanel></Grid>
    <StackPanel Grid.Row="3"><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="2" Background="#D2D9CF" Foreground="#687D65" BorderThickness="0"/><TextBlock Text="{Binding LastReadText}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
   </Grid></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <ScrollViewer x:Name="ShelfEmpty" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,20" MaxWidth="420">
    <Image Source="Assets/AppIcon.png" Width="64" Height="64" Margin="0,0,0,22" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock x:Name="ShelfEmptyMessage" Text="书架还空着" FontFamily="SimSun" FontSize="24" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
    <TextBlock x:Name="ShelfEmptyDetail" Text="导入正在读的小说，也可以把 TXT 或 EPUB 拖进来" Foreground="{StaticResource Muted}" Margin="0,12,0,24" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"/>
    <StackPanel x:Name="ShelfEmptyImport" Orientation="Horizontal" HorizontalAlignment="Center">
     <Button Content="导入书籍" Click="OnOpen" Background="#354A40" Foreground="#FAF8F2" Padding="24,11" AutomationProperties.AutomationId="EmptyImport"/>
     <Button Content="先读示例" Click="OnDemo" Margin="12,0,0,0" Foreground="{StaticResource Muted}" AutomationProperties.AutomationId="EmptyDemo"/>
    </StackPanel>
    <Button x:Name="ShelfClearFilter" Content="清除筛选" Click="OnClearShelfFilter" Background="#354A40" Foreground="#FAF8F2" HorizontalAlignment="Center" Padding="24,11" Visibility="Collapsed" AutomationProperties.AutomationId="ClearShelfFilter"/>
   </StackPanel>
  </ScrollViewer>
  <TextBlock x:Name="ShelfNotice" Grid.Row="3" Text="阅读进度和书签保存在本机" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/>
 </Grid>
</Grid>
</Grid>
</Window>
