<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <AssemblyName>TxtReader</AssemblyName>
    <Version>0.2.0</Version>
    <InformationalVersion>0.2.0-preview.2</InformationalVersion>
    <Product>栖读</Product>
    <Description>Offline Chinese TXT novel reader</Description>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TxtReader.Core\TxtReader.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup><Content Include="..\..\samples\山海来信.txt" Link="samples\sample-novel.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="..\..\docs\preview-quickstart.txt" Link="Quickstart.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\AppIcon.ico" /><Resource Include="Assets\AppIcon.png" /></ItemGroup>
</Project>
